# Copy to .env and fill in. Any OpenAI-compatible API works (Gemini, OpenAI, Ollama, ...).

# --- Option A: Gemini (free tier, key from https://aistudio.google.com/apikey) ---
LLM_PROVIDER=openai_compatible
LLM_API_KEY=your-gemini-key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CHAT_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# --- Option B: OpenAI ---
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIM=1536

# --- Option C: no key at all (fake embeddings + canned answer, for testing the pipeline) ---
# LLM_PROVIDER=fake

DATABASE_URL=postgresql://documind:documind@localhost:5433/documind
