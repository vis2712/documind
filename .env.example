# Copy to .env and fill in:  cp .env.example .env
# Only LLM_API_KEY and JWT_SECRET are required. Everything else has a sensible default (see app/config.py).

# ---------- LLM: any OpenAI-compatible API ----------
# Option A: Gemini (free tier; key from https://aistudio.google.com/apikey)
LLM_PROVIDER=openai_compatible
LLM_API_KEY=your-gemini-key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CHAT_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# USD per 1M tokens, for the cost shown per answer. Check current pricing for your model.
PRICE_INPUT_PER_M=0.30
PRICE_OUTPUT_PER_M=2.50

# Option B: OpenAI
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIM=1536                # changing EMBED_DIM needs a fresh DB: docker compose down -v

# Option C: no key at all (fake embeddings + canned answers; for testing the plumbing)
# LLM_PROVIDER=fake

# ---------- Auth (required) ----------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me
JWT_EXPIRE_MINUTES=60

# ---------- Infrastructure (defaults match docker compose) ----------
DATABASE_URL=postgresql://documind:documind@localhost:5433/documind
REDIS_URL=redis://localhost:6379/0
QUEUE_BACKEND=rq                # rq = Redis worker with retries; background = in-process, no Redis
STORAGE_BACKEND=local           # local | s3
# S3_BUCKET=my-documind-bucket  # with STORAGE_BACKEND=s3 (AWS credentials from env / IAM role)

# ---------- Ingestion & retrieval ----------
OCR_ENGINE=auto                 # auto | tesseract | llm | none   (auto: tesseract if installed, else the vision model)
RERANKER=local                  # local (cross-encoder on CPU) | none
TOP_K=5

# ---------- Tracing (optional): free keys at https://cloud.langfuse.com ----------
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
